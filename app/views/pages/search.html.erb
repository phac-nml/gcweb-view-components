<% query = params[:q].presence || t("app.search.default_query") %>
<% results = t("app.search.results") %>

<section class="container search-page">
  <h1><%= t("app.search.heading") %></h1>

  <search>
    <form action="<%= search_page_path %>" method="get">
      <label class="visually-hidden" for="search-query"><%= t("app.search.form.label") %></label>
      <div class="search-page__input-group">
        <input id="search-query" name="q" class="search-page__input" type="search" value="<%= query %>" aria-describedby="search-privacy-note">
        <button type="submit" class="search-page__submit"><%= t("app.search.form.button") %></button>
      </div>
      <p id="search-privacy-note" class="search-page__privacy-note"><%= t("app.search.form.privacy_note") %></p>
    </form>
  </search>

  <section id="wb-land">
    <h2><%= t("app.search.summary", count: results.length, term: query) %></h2>

    <div class="search-page__results">
      <% results.each do |result| %>
        <article class="search-result">
          <h3><%= link_to result["title"], result["url"] %></h3>
          <% if result["location"].present? %>
            <ol class="search-result__location">
              <% result["location"].each do |crumb| %>
                <li><%= crumb %></li>
              <% end %>
            </ol>
          <% end %>
          <p>
            <time datetime="<%= result["date_iso"] %>" class="search-result__date"><%= result["date_label"] %></time>
            -
            <%= result["description"] %>
          </p>
        </article>
      <% end %>
    </div>

    <nav class="search-page__pagination-wrap" aria-label="<%= t("app.search.pagination.aria_label") %>">
      <ul class="search-page__pagination">
        <% t("app.search.pagination.pages").each_with_index do |page, index| %>
          <li class="<%= "active" if index.zero? %>">
            <%= link_to page["label"], page["url"], "aria-current": (index.zero? ? "page" : nil) %>
          </li>
        <% end %>
        <li>
          <%= link_to t("app.search.pagination.next"), t("app.search.pagination.next_url"), rel: "next" %>
        </li>
      </ul>
    </nav>
  </section>

  <p class="search-page__advanced">
    <%= link_to t("app.search.advanced.label"), t("app.search.advanced.url") %>
  </p>

  <section class="search-page__details">
    <h2 class="visually-hidden"><%= t("app.search.page_details.heading") %></h2>
    <dl id="wb-dtmd">
      <dt><%= t("app.search.page_details.date_label") %></dt>
      <dd>
        <time datetime="<%= t("app.search.page_details.date_value") %>"><%= t("app.search.page_details.date_value") %></time>
      </dd>
    </dl>
  </section>
</section>
