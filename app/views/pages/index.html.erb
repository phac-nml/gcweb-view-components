<section class="workbench container">
  <h1><%= t("app.workbench.heading") %></h1>
  <p><%= t("app.workbench.description") %></p>

  <ul class="workbench__links">
    <% if defined?(Lookbook::Engine) %>
      <li><%= link_to t("app.workbench.lookbook_link"), "/lookbook" %></li>
    <% end %>
    <li><%= link_to t("app.workbench.rails_preview_link"), "/rails/view_components" %></li>
    <li><%= link_to t("app.workbench.alert_preview_link"), "/rails/view_components/gcweb/alert_component/en" %></li>
    <li><%= link_to t("app.workbench.featured_link_preview_link"), "/rails/view_components/gcweb/featured_link_component/en" %></li>
  </ul>

  <h2><%= t("app.workbench.backlog_heading") %></h2>
  <table class="workbench__table">
    <thead>
      <tr>
        <th scope="col"><%= t("app.workbench.table.component") %></th>
        <th scope="col"><%= t("app.workbench.table.reference") %></th>
        <th scope="col"><%= t("app.workbench.table.status") %></th>
      </tr>
    </thead>
    <tbody>
      <% @wet_component_backlog.each do |component| %>
        <tr>
          <th scope="row"><%= component[:name] %></th>
          <td><%= link_to component[:slug], component[:reference_url] %></td>
          <td><%= t("app.workbench.status.#{component[:status]}") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
