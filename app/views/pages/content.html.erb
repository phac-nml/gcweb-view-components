<section class="container content-page">
  <nav aria-label="<%= t("app.content.breadcrumb_aria_label") %>" class="content-page__breadcrumbs">
    <ol>
      <% t("app.content.breadcrumbs").each do |item| %>
        <li>
          <% if item["url"].present? %>
            <%= link_to item["label"], item["url"] %>
          <% else %>
            <span aria-current="page"><%= item["label"] %></span>
          <% end %>
        </li>
      <% end %>
    </ol>
  </nav>

  <h1><%= t("app.content.heading") %></h1>

  <section class="content-page__alert" aria-labelledby="content-alert-heading">
    <h2 id="content-alert-heading"><%= t("app.content.alert.heading") %></h2>
    <p><%= t("app.content.alert.description") %></p>
  </section>

  <section class="content-featured-link">
    <h2 class="visually-hidden"><%= t("app.content.featured.heading") %></h2>
    <p>
      <%= link_to t("app.content.featured.title"), t("app.content.featured.url"), class: "content-featured-link__link" %>
    </p>
    <p><%= t("app.content.featured.description") %></p>
  </section>

  <section class="content-page__most-requested">
    <h2><%= t("app.content.most_requested.heading") %></h2>
    <ul>
      <% t("app.content.most_requested.links").each do |entry| %>
        <li><%= link_to entry["label"], entry["url"] %></li>
      <% end %>
    </ul>
  </section>

  <section class="content-page__services">
    <h2 class="visually-hidden"><%= t("app.content.services.heading") %></h2>
    <div class="content-page__services-grid">
      <% t("app.content.services.items").each do |entry| %>
        <article>
          <h3><%= link_to entry["title"], entry["url"] %></h3>
          <p><%= entry["description"] %></p>
        </article>
      <% end %>
    </div>
  </section>

  <section class="content-page__details">
    <h2 class="visually-hidden"><%= t("app.content.page_details.heading") %></h2>
    <dl id="wb-dtmd">
      <dt><%= t("app.content.page_details.date_label") %></dt>
      <dd>
        <time datetime="<%= t("app.content.page_details.date_value") %>"><%= t("app.content.page_details.date_value") %></time>
      </dd>
    </dl>
  </section>
</section>
