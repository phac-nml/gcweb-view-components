<div class="home-hero">
  <section class="container home-hero__inner">
    <h1><%= t("app.home.banner.title") %></h1>
    <p><%= t("app.home.banner.description") %></p>
  </section>
  <section class="home-featured-link">
    <div class="container">
      <h2 class="visually-hidden"><%= t("app.home.featured.heading") %></h2>
      <p>
        <%= link_to t("app.home.featured.title"), t("app.home.featured.url"), class: "home-featured-link__link" %>
      </p>
      <p><%= t("app.home.featured.description") %></p>
    </div>
  </section>
</div>

<section class="home-most-requested">
  <div class="container">
    <h2><%= t("app.home.most_requested.heading") %></h2>
    <ul class="home-most-requested__list">
      <% t("app.home.most_requested.links").each do |entry| %>
        <li><%= link_to entry["label"], entry["url"] %></li>
      <% end %>
    </ul>
  </div>
</section>

<section class="home-services">
  <div class="container">
    <h2 class="visually-hidden"><%= t("app.home.services.heading") %></h2>
    <div class="home-services__grid">
      <% t("app.home.services.items").each do |entry| %>
        <article>
          <h3><%= link_to entry["title"], entry["url"] %></h3>
          <p><%= entry["description"] %></p>
        </article>
      <% end %>
    </div>
    <p>
      <%= link_to t("app.home.services.all_services_label"), t("app.home.services.all_services_url"), class: "home-services__all" %>
    </p>
  </div>
</section>
