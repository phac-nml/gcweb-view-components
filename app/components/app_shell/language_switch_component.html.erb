<nav class="language-switch" aria-label="<%= t("app.language_switch.aria_label") %>">
  <ul class="language-switch__list">
    <% links.each do |link| %>
      <% active = I18n.locale == link[:locale] %>
      <li>
        <%= link_to link[:label], language_href(link[:locale]), class: "language-switch__link", lang: link[:locale], "aria-current": (active ? "true" : nil) %>
      </li>
    <% end %>
  </ul>
</nav>
