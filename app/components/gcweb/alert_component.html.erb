<%= content_tag wrapper_tag, **wrapper_attributes do %>
  <% if collapsible? %>
    <%= tag.details(open: open?) do %>
      <summary><%= heading_tag %></summary>
      <%= content %>
    <% end %>
  <% else %>
    <% if heading %><%= heading_tag %><% end %>
    <%= content %>
  <% end %>
<% end %>
