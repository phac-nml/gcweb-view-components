{
  "all": {
    "sourceCodeDir": "app/frontend",
    "packageManager": "pnpm",
    "viteBinPath": "../node_modules/.bin/vite",
    "watchAdditionalPaths": ["../app/assets/**/*"]
  },
  "development": {
    "autoBuild": true,
    "skipProxy": true,
    "publicOutputDir": "vite-dev",
    "port": 3036
  },
  "test": {
    "autoBuild": true,
    "publicOutputDir": "vite-test",
    "port": 3037
  }
}
