<%= render Gcweb::AccordionComponent.new(id: "remembered", persist: :session) do |accordion| %>
  <% (1..3).each do |number| %>
    <% accordion.with_section(title: t("previews.toggle.example", number: number), open: number == 1) do %>
      <p><%= t("previews.toggle.content") %></p>
    <% end %>
  <% end %>
<% end %>
