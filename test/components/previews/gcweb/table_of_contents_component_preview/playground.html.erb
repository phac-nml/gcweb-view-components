<%= render Gcweb::TableOfContentsComponent.new(title: title, heading_level: heading_level) do |toc| %>
  <% (1..3).each do |n| %>
    <% toc.with_link(t("previews.toc.sections.#{n}"), href: "#section#{n}") %>
  <% end %>
<% end %>
<% (1..3).each do |n| %>
  <section>
    <h2 id="section<%= n %>">[<%= t("previews.toc.sections.#{n}") %>]</h2>
    <p><%= t("previews.toc.text") %></p>
  </section>
<% end %>
