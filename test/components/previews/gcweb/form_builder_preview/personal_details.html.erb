<%= gcweb_form_with model: details, scope: :personal_details, url: "#" do |f| %>
  <%= f.fieldset_group legend: t("previews.form.address_heading"), heading: :h2 do %>
    <%= f.text_area_group :address, maxlength: 100, cols: 51, rows: 4 %>
    <%= f.text_field_group :city, maxlength: 50, size: 50 %>
    <%= f.text_field_group :postal_code, maxlength: 7, size: 7, autocomplete: "postal-code" %>
  <% end %>
  <%= f.fieldset_group :date_of_birth, hint: t("previews.form.date_hint") do %>
    <%= f.text_field_group :birth_year, maxlength: 4, size: 4, inputmode: "numeric", autocomplete: "bday-year" %>
    <%= f.text_field_group :birth_month, maxlength: 2, size: 2, inputmode: "numeric", autocomplete: "bday-month" %>
    <%= f.text_field_group :birth_day, maxlength: 2, size: 2, inputmode: "numeric", autocomplete: "bday-day" %>
  <% end %>
<% end %>
