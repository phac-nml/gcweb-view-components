<ul>
  <li><p><%= gcweb_overlay_link_to t("previews.overlay.top_bar"), "top-bar" %></p></li>
  <li><p><%= gcweb_overlay_link_to t("previews.overlay.bottom_bar"), "bottom-bar" %></p></li>
</ul>
<%= render Gcweb::OverlayComponent.new(id: "top-bar", title: t("previews.overlay.top_bar"), variant: :bar_top) do %>
  <%= render "gcweb/overlay_component_preview/buttons" %>
<% end %>
<%= render Gcweb::OverlayComponent.new(id: "bottom-bar", title: t("previews.overlay.bottom_bar"), variant: :bar_bottom) do %>
  <%= render "gcweb/overlay_component_preview/buttons" %>
<% end %>
